{
  "name": "yerbacapital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.10.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:app": "pnpm --filter app dev",
    "dev:svc": "pnpm --filter @yerbacapital/evidence build && pnpm --filter @yerbacapital/evidence start",
    "test:e2e": "pnpm --filter app test:e2e"
  },
  "devDependencies": {
    "@types/node": "22",
    "eslint": "9",
    "typescript": "5.9.3",
    "typescript-eslint": "8"
  }
}
