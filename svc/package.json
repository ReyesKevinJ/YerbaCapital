{
  "name": "@yerbacapital/evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "evidence": "node dist/src/cli.js",
    "start": "node --env-file=../.env dist/src/server.js",
    "index": "node --env-file=../.env dist/src/indexer/run.js",
    "pilot:backup": "pnpm build && node --env-file=../.env dist/src/pilot/backup-cli.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.0.1"
  }
}
